# Alpaca PAPER account (the app refuses to run against a live URL)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Claude reviewer + daily journal
ANTHROPIC_API_KEY=
# Shared secret for /api/tick and /api/cron/* (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=

# Google sign-in for the dashboard (OAuth client: Google Cloud console > APIs & Services > Credentials).
# Authorized redirect URI: https://<your-app>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs session cookies; any long random string (openssl rand -base64 32). Changing it signs every device out.
AUTH_SECRET=
# Google accounts allowed in, comma-separated
OWNER_EMAILS=
